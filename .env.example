# Prodmax environment variables — all optional.
# Copy to .env and fill in only what you need.

# AI provider for the BYOK LLM upgrade path (architecture §6.3).
# Default: "deterministic" (offline local engine, no network).
AI_PROVIDER=deterministic

# API key for the hosted provider. Only needed when AI_PROVIDER
# targets a hosted LLM; ignored by the deterministic engine.
AI_API_KEY=

# Model identifier for the hosted provider (e.g. claude-sonnet-4-5).
AI_MODEL=
